generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model admins {
  admin_id   Int       @id @default(autoincrement())
  username   String    @unique(map: "username") @db.VarChar(50)
  password   String    @db.VarChar(255)
  full_name  String    @db.VarChar(100)
  email      String?   @unique(map: "email") @db.VarChar(100)
  role       String?   @default("admin") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model appointments {
  appointment_id   Int               @id @default(autoincrement())
  customer_id      Int
  service_id       Int
  pet_name         String            @db.VarChar(100)
  appointment_date DateTime          @db.DateTime(0)
  status           String?           @default("Pending") @db.VarChar(50)
  note             String?           @db.Text
  payment_method   String?           @db.VarChar(50)
  receipt_image    String?           @db.VarChar(255)
  created_at       DateTime?         @default(now()) @db.DateTime(0)
  customers        customers         @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, map: "fk_appointment_customer")
  services         services          @relation(fields: [service_id], references: [service_id], onDelete: Cascade, map: "fk_appointment_service")
  staff_schedules  staff_schedules[]

  @@index([customer_id], map: "fk_appointment_customer")
  @@index([service_id], map: "fk_appointment_service")
}

model categories {
  category_id   Int        @id @default(autoincrement())
  category_name String     @db.VarChar(100)
  description   String?    @db.Text
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  products      products[]
}

model contacts {
  contact_id Int       @id @default(autoincrement())
  full_name  String    @db.VarChar(100)
  email      String?   @db.VarChar(100)
  phone      String?   @db.VarChar(20)
  message    String    @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model customers {
  customer_id  Int       @id @default(autoincrement())
  full_name    String    @db.VarChar(100)
  phone        String    @db.VarChar(20)
  email        String?   @db.VarChar(100)
  password     String    @db.VarChar(255)
  address      String?   @db.Text
  avatar       String?   @db.VarChar(500)
  is_active    Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  appointments appointments[]
  orders       orders[]
  pets         pets[]
}

model order_details {
  order_detail_id Int      @id @default(autoincrement())
  order_id        Int
  product_id      Int
  quantity        Int      @default(1)
  price           Decimal  @db.Decimal(10, 2)
  orders          orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_orderdetail_order")
  products        products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, map: "fk_orderdetail_product")

  @@index([order_id], map: "fk_orderdetail_order")
  @@index([product_id], map: "fk_orderdetail_product")
}

model orders {
  order_id       Int             @id @default(autoincrement())
  customer_id    Int
  total_amount   Decimal         @db.Decimal(10, 2)
  order_status   String?         @default("Pending") @db.VarChar(50)
  payment_method String?         @default("COD") @db.VarChar(50)
  receipt_image  String?         @db.VarChar(255)
  created_at     DateTime?       @default(now()) @db.DateTime(0)
  order_details  order_details[]
  customers      customers       @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, map: "fk_order_customer")

  @@index([customer_id], map: "fk_order_customer")
}

model pets {
  pet_id      Int       @id @default(autoincrement())
  customer_id Int
  name        String    @db.VarChar(100)
  type        String    @db.VarChar(50)
  breed       String?   @db.VarChar(100)
  gender      pets_gender?
  age         Int?
  weight      Decimal?  @db.Decimal(5, 2)
  color       String?   @db.VarChar(50)
  note        String?   @db.Text
  image       String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  customers   customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, map: "fk_pet_customer")

  @@index([customer_id], map: "fk_pet_customer")
}

model products {
  product_id    Int             @id @default(autoincrement())
  category_id   Int?
  product_name  String          @db.VarChar(150)
  price         Decimal         @db.Decimal(10, 2)
  stock         Int?            @default(0)
  image         String?         @db.Text
  description   String?         @db.Text
  details       String?         @db.Text
  specifications String?        @db.Text
  created_at    DateTime?       @default(now()) @db.DateTime(0)
  order_details order_details[]
  categories    categories?     @relation(fields: [category_id], references: [category_id], map: "fk_product_category")

  @@index([category_id], map: "fk_product_category")
}


model services {
  service_id   Int       @id @default(autoincrement())
  service_name String    @db.VarChar(150)
  price        Decimal   @db.Decimal(10, 2)
  image        String?   @db.VarChar(255)
  description  String?   @db.Text
  category     String?   @default("Vệ sinh & Spa") @db.VarChar(100)
  duration     Int?      @default(30)
  is_active    Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  appointments appointments[]
}

model staff {
  staff_id        Int       @id @default(autoincrement())
  full_name       String    @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  email           String?   @db.VarChar(100)
  position        String?   @db.VarChar(50)
  salary          Decimal?  @db.Decimal(10, 2)
  avatar          String?   @db.VarChar(500)
  is_active       Boolean   @default(true)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  staff_schedules staff_schedules[]
}

model staff_schedules {
  schedule_id    Int          @id @default(autoincrement())
  appointment_id Int
  staff_id       Int
  work_date      DateTime     @db.Date
  start_time     DateTime     @db.Time(0)
  end_time       DateTime     @db.Time(0)
  note           String?      @db.Text
  created_at     DateTime?    @default(now()) @db.DateTime(0)
  appointments   appointments @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade, map: "fk_schedule_appointment")
  staff          staff        @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade, map: "fk_schedule_staff")

  @@index([appointment_id], map: "fk_schedule_appointment")
  @@index([staff_id], map: "fk_schedule_staff")
}

enum pets_gender {
  male
  female
}


enum payments_status {
  processing
  paid
  cancelled
}

model payments {
  payment_id     Int              @id @default(autoincrement())
  source_type    String           @db.VarChar(20)  // "order" | "appointment"
  source_id      Int
  amount         Decimal          @db.Decimal(10, 2)
  payment_method String?          @db.VarChar(50)
  receipt_image  String?          @db.VarChar(255)
  status         payments_status  @default(processing)
  description    String?          @db.VarChar(255)
  created_at     DateTime?        @default(now()) @db.DateTime(0)
}

model password_resets {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(100)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([email])
}

model shop_settings {
  key        String   @id @db.VarChar(100)
  value      String   @db.Text
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  type            String    @db.VarChar(30)  // "order" | "booking" | "stock" | "contact"
  title           String    @db.VarChar(255)
  message         String    @db.Text
  source_id       Int?      // order_id / appointment_id / product_id
  is_read         Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.DateTime(0)
}

model articles {
  article_id  Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  category    String    @db.VarChar(100)
  description String?   @db.Text
  content     String    @db.Text
  image       String?   @db.VarChar(255)
  status      String?   @default("published") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.DateTime(0)
}

